DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://your-neon-auth-host/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-32-byte-secret
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=replace-with-a-random-worker-secret
CUSTOMER_DATA_MODE=tokenized-only
PLAYMIND_MAX_UPLOAD_BYTES=500000000
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=
# Intake (npm run intake): HMAC salt for trader and event ID tokens. Set a long random value
# in your local .env only. Never commit it or log it. Intake refuses to run without it.
PLAYMIND_TOKEN_SALT=
# Optional local-only setting. The normal path queues a job, then the worker processes it.
PLAYMIND_INLINE_JOBS=false
